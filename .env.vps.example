# Copia este ficheiro para ".env" no VPS e preenche os valores reais.
# NUNCA commites o .env real para o GitHub (já está no .gitignore).

# --- Postgres ---
POSTGRES_USER=kubo
POSTGRES_PASSWORD=troca-esta-password-por-uma-forte
POSTGRES_DB=n8n

# --- n8n ---
# Domínio (ou subdomínio) que vais apontar para o IP do VPS, ex: n8n.kuboloko.pt
N8N_HOST=n8n.kuboloko.pt
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troca-esta-password-por-uma-forte

# --- WAHA ---
WAHA_API_KEY=troca-esta-key-por-uma-forte
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troca-esta-password-por-uma-forte
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=troca-esta-password-por-uma-forte

# Domínio para o WAHA, ex: waha.kuboloko.pt (usado no Caddyfile)
WAHA_HOST=waha.kuboloko.pt

# Email para certificados HTTPS automáticos (Let's Encrypt via Caddy)
ACME_EMAIL=kuboloko.info@gmail.com
